# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Local Cloudflare Workers secrets for `vinext dev`/wrangler dev -- never had a gitignore entry
# before, so this was a real (if so-far unexploited -- confirmed via `git log` -- no leaked secret
# in history) gap.
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Private local Tally migration output
.local-data/

# Local development logs
dev-output.log
dev-error.log

# Local safety copies
*.backup
*.cosmetic-backup
*.masters-backup
/backup-*/
*.tsx.*
*.css.*
*.js.*
components/GenericHome.*.tsx

# TypeScript incremental build cache
*.tsbuildinfo

# Local tool config
/.claude/
