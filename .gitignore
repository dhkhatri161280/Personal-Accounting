# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# tesseract.js downloads its OCR language model here when run under Node (e.g. local dev/test
# scripts) -- in production the browser build loads it from tesseract.js's own CDN at runtime,
# never from this file, so it's local dev noise, not a build artifact.
*.traineddata

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Local Cloudflare Workers secrets for `vinext dev`/wrangler dev -- never had a gitignore entry
# before, so this was a real (if so-far unexploited -- confirmed via `git log` -- no leaked secret
# in history) gap.
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Private local Tally migration output
.local-data/

# Local development logs
dev-output.log
dev-error.log

# Local safety copies
*.backup
*.cosmetic-backup
*.masters-backup
/backup-*/
*.tsx.*
*.css.*
*.js.*
components/GenericHome.*.tsx

# TypeScript incremental build cache
*.tsbuildinfo

# Local tool config
/.claude/

# tools/tally-sync and tools/costco-receipts write timestamped local safety copies of the full
# encrypted vault before every direct write (confirmed live: none of these had a gitignore entry
# before, a real gap since a broad `git add` could otherwise sweep a full vault backup into a
# commit -- harmless since it's encrypted, but bulky and not meant to be versioned). Same for the
# Tally sync's own raw XML response audit files.
tools/*/encrypted-*-vault-before-*.json
tools/*/tally-*-one-*-response-*.xml
